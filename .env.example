# Copy to .env.local and fill in. Never commit real values.

# Public (safe in the client; access is enforced by Row Level Security)
EXPO_PUBLIC_SUPABASE_URL=https://lrhbnduacmrfixzgzcgp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (Edge Functions / CI). Never prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_AUTH_TOKEN=
POSTHOG_API_KEY=

# Edge Functions: comma-separated web origins allowed to call them.
ALLOWED_ORIGINS=http://localhost:8081

# Auth providers (set in the Supabase dashboard for the hosted project).
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Local database tests (must end in _test; the test runner recreates it).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/goalz_test
