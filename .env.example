# Copy to .env.local and fill in. Never commit real values.
# Public (safe in the client; access is enforced by Row Level Security)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (Edge Functions / CI). Never prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_AUTH_TOKEN=
POSTHOG_API_KEY=
